# Copy this file to .env and fill in real values.
# This file is committed to the repo as a reference; never commit .env itself.
SECRET_KEY=change-me-to-a-long-random-string
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_EMAIL=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback URL registered in the Google OAuth consent screen.
# Leave blank to auto-detect (http://host:port/login/google/callback).
# GOOGLE_REDIRECT_URI=http://localhost:5000/login/google/callback

# Optional overrides
# DATABASE_PATH=/absolute/path/to/skillhub.db
# COOKIE_SECURE=0
# PORT=5000